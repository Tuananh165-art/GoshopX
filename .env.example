POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

ACCOUNT_DATABASE_URL=
ORDER_DATABASE_URL=
PAYMENT_DATABASE_URL=
INVENTORY_DATABASE_URL=
NOTIFICATION_DATABASE_URL=
ADMIN_DATABASE_URL=
RECOMMENDER_DATABASE_URL=
PRODUCT_DATABASE_URL=
DUMMYJSON_BASE_URL=
DUMMYJSON_SEED_ENABLED=false
DUMMYJSON_SEED_LIMIT=0

ACCOUNT_SERVICE_URL=account:8080
PRODUCT_SERVICE_URL=product:8080
ORDER_SERVICE_URL=order:8080
PAYMENT_SERVICE_URL=payment:8080
RECOMMENDER_SERVICE_URL=recommender:8080
INVENTORY_SERVICE_URL=inventory:8080
CART_SERVICE_URL=cart:8080
VND_PER_USD=25000
NOTIFICATION_SERVICE_URL=notification:8080
ACCOUNT_SERVICE_URL=account:8080
ADMIN_SERVICE_URL=admin:8080

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ADMIN_EVENTS_TOPIC=admin_events
PRODUCT_EVENTS_TOPIC=product_events
INTERACTION_EVENTS_TOPIC=interaction_events
ORDER_EVENTS_TOPIC=order_events
PAYMENT_EVENTS_TOPIC=payment_events
INVENTORY_EVENTS_TOPIC=inventory_events
CART_EVENTS_TOPIC=cart_events

REDIS_URL=redis:6379
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=goshopx-minio
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=product-media
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000
ARTIFACTS_LOCAL_PATH=/app/artifacts

# Product chatbot LLM. Keep the real key only in local .env or a secret manager.
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Hybrid RAG vector index.
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=product_catalog_v1
TEXT_EMBEDDING_DIMENSION=512
IMAGE_EMBEDDING_DIMENSION=512
INVENTORY_EVENTS_TOPIC=inventory_events

SECRET_KEY=change-me-local-secret
ISSUER=goshopx-local

# Google Sign-In (OAuth 2.0 Web client ID; public value used by the web build and token audience)
GOOGLE_CLIENT_ID=

# Gmail SMTP transactional notifications. Use a Gmail App Password, not the normal account password.
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_USERNAME=
GMAIL_PASSWORD=
GMAIL_FROM=

VNPAY_TMN_CODE=<sandbox terminal id>
VNPAY_HASH_SECRET=<sandbox hash secret>
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
