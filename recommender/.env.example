# Product chatbot LLM. Keep the real key only in local .env or a secret manager.
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-flash
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
TAVILY_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
TYPESAFE_JEV_MODEL=jev-1.14.0
JEV_MODE=shadow
JEV_RERANK_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=goshopx-recommender
AI_SPEND_LIMIT_VND=200000
AI_SPEND_RESERVE_PER_CALL_VND=500
# Enter reviewed, operator-maintained rates from provider pricing/invoices.
# Token rates are integer VND per million tokens; blank means reserve stays charged.
AI_DEEPSEEK_INPUT_VND_PER_MILLION_TOKENS=
AI_DEEPSEEK_OUTPUT_VND_PER_MILLION_TOKENS=
AI_GEMINI_INPUT_VND_PER_MILLION_TOKENS=
AI_GEMINI_OUTPUT_VND_PER_MILLION_TOKENS=
AI_TAVILY_CALL_VND=
AI_TYPESAFE_CALL_VND=
# Enter reviewed, operator-maintained rates from provider pricing/invoices.
# Token rates are integer VND per million tokens; blank means reserve stays charged.
AI_DEEPSEEK_INPUT_VND_PER_MILLION_TOKENS=
AI_DEEPSEEK_OUTPUT_VND_PER_MILLION_TOKENS=
AI_GEMINI_INPUT_VND_PER_MILLION_TOKENS=
AI_GEMINI_OUTPUT_VND_PER_MILLION_TOKENS=
AI_TAVILY_CALL_VND=
AI_TYPESAFE_CALL_VND=

# Hybrid RAG vector index.
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=product_catalog_hash_v1
TEXT_EMBEDDING_DIMENSION=512
IMAGE_EMBEDDING_DIMENSION=512
INVENTORY_EVENTS_TOPIC=inventory_events
