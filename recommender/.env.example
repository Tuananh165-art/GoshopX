# Product chatbot LLM. Keep the real key only in local .env or a secret manager.
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-flash
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
TAVILY_API_KEY=
TYPESAFE_API_KEY=
LANGSMITH_API_KEY=

# Hybrid RAG vector index.
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=product_catalog_hash_v1
TEXT_EMBEDDING_DIMENSION=512
IMAGE_EMBEDDING_DIMENSION=512
INVENTORY_EVENTS_TOPIC=inventory_events
